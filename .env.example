# Copie para .env (nesta pasta). O .env está no .gitignore: nunca faça commit dele.

# Token da assinatura do Claude, gerado por `claude setup-token` (começa com sk-ant-oat01-).
# Só o container do agente recebe esta variável. É para uso pessoal; um deploy usaria chave de API.
CLAUDE_CODE_OAUTH_TOKEN=

# Opcionais
# POSTGRES_PASSWORD=dash-local
# API_PORT=8000      # página + API
# AGENT_PORT=8100    # camada dash-ai (agente)
# DB_PORT=5433       # Postgres exposto na máquina
